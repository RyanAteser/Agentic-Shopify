SCOPES=write_content,read_products
N8N_BLOG_WEBHOOK_URL=
N8N_OUTBOUND_KEY=
N8N_CALLBACK_SECRET=

# Ranking connector uses per-merchant hashed DB keys, not a global secret.
# Provision with scripts/ranking-connector-key.ts from a trusted operator shell.

# Google Search Console (merchant-consented, read-only):
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# 32 random bytes, base64-encoded, in a dedicated key-management secret:
GSC_ENCRYPTION_KEY=
# PostgreSQL production database URL. SQLite is local development only:
DATABASE_URL=
