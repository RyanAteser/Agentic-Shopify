{
  "name": "Agentic Shopify | Verified Organic Growth Daily Sync",
  "nodes": [
    {
      "id": "growth-daily-schedule",
      "name": "Daily Growth Measurement",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 20
            }
          ]
        }
      }
    },
    {
      "id": "growth-sync-endpoint",
      "name": "Sync Verified Search Console Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PUBLISHED-SHOPIFY-APP.example/api/growth/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 120000
        }
      }
    }
  ],
  "connections": {
    "Daily Growth Measurement": {
      "main": [
        [
          {
            "node": "Sync Verified Search Console Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "active": false,
  "pinData": {}
}
