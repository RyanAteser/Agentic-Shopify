{
  "name": "Agentic Shopify | Queued Job Recovery (opt-in)",
  "nodes": [
    {
      "id": "recovery-check",
      "name": "Recovery Sweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "recover-queued",
      "name": "Recover Unclaimed Queued Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PUBLISHED-SHOPIFY-APP.example/api/agent/recover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Recovery Sweep": {
      "main": [
        [
          {
            "node": "Recover Unclaimed Queued Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
