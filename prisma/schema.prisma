// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreConfig {
  shop             String   @id
  blogId           String   @default("")
  authorName       String   @default("Editorial Team")
  audience         String   @default("")
  brandVoice       String   @default("")
  seedTopics       String   @default("")
  cadenceDays      Int      @default(7)
  topicCursor       Int      @default(0)
  freeDraftsUsed    Int      @default(0)
  rankingWindowStart DateTime?
  rankingRequestsUsed Int      @default(0)
  rankingRecordsUsed  Int      @default(0)
  lastManagerSyncAt DateTime?
  // Latest explicit Google disconnect, retained while the Shopify app remains installed.
  gscConsentRevokedAt DateTime?
  // Monotonic consent ordering, independent of wall-clock corrections.
  gscConsentRevokedOrder BigInt @default(0)
  nextRunAt        DateTime?
  enabled          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContentJob {
  id               String   @id @default(cuid())
  shop             String
  topic            String
  status           String   @default("queued")
  // Only jobs created after the recovery contract is introduced are auto-recoverable.
  outboxVersion    Int      @default(0)
  // Immutable schedule snapshot for a definitive rejection/refund after a crash.
  scheduleClaim    String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([shop, status])
  @@index([outboxVersion, status, createdAt])
}

model ArticleDraft {
  id               String   @id @default(cuid())
  shop             String
  jobId            String   @unique
  topic            String
  title            String
  summary          String
  body             String
  tags             String   @default("")
  keyword          String   @default("")
  seoScore         Int      @default(0)
  reviewNotes      String   @default("")
  status           String   @default("ready")
  shopifyArticleId String?
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([shop, status])
}

model RankingConnectorCredential {
  shop      String   @id
  keyHash   String   @unique
  createdAt DateTime @default(now())
  rotatedAt DateTime @default(now())
}

model SeoRankObservation {
  id          String   @id @default(cuid())
  shop        String
  keyword     String
  engine      String   @default("google")
  country     String   @default("US")
  device      String   @default("desktop")
  position    Int?
  targetUrl   String   @default("")
  source      String   @default("brightdata-serp")
  observedAt  DateTime
  receivedAt  DateTime @default(now())
  @@unique([shop, keyword, engine, country, device, observedAt])
  @@index([shop, observedAt])
  @@index([shop, keyword])
}

model StoreRecommendation {
  id           String   @id @default(cuid())
  shop         String
  sourceKey    String
  agent        String
  kind         String
  targetId     String
  title        String
  rationale    String
  evidence     String   @default("")
  priority     Int      @default(50)
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  decidedAt    DateTime?
  @@unique([shop, sourceKey])
  @@index([shop, status, priority])
}

model StoreActivity {
  id                String   @id @default(cuid())
  shop              String
  recommendationId  String?
  actorId           String?
  action            String
  outcome           String
  detail            String   @default("")
  createdAt         DateTime @default(now())
  @@index([shop, createdAt])
}

// One database-serialized counter for Google Connect/Disconnect intents.
// No merchant identity or token is retained in this global sequence.
model GscConsentOrderCounter {
  id       Int    @id
  sequence BigInt @default(0)
}

model GoogleAuthState {
  stateHash   String   @id
  shop        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  @@index([shop, expiresAt])
}

model SearchConsoleConnection {
  shop               String   @id
  property           String
  encryptedRefresh   String
  status             String   @default("active")
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastSyncedAt       DateTime?
  lastSyncStartedAt  DateTime?
  lastPageSyncedAt      DateTime?
  lastPageSyncStartedAt DateTime?
}

model OrganicDailyMetric {
  id             String   @id @default(cuid())
  shop           String
  property       String
  date           String
  clicks         Float
  impressions    Float
  ctr            Float
  position       Float
  importedAt     DateTime @default(now())
  @@unique([shop, property, date])
  @@index([shop, date])
}



/// Read-only Google Search Console metrics for merchant-verified product URLs.
/// Missing page/date rows are unobserved, never invented as zero traffic.
model GscProductDailyMetric {
  id          String   @id @default(cuid())
  shop        String
  property    String
  pageUrl     String
  date        String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  importedAt  DateTime @default(now())
  @@unique([shop, property, pageUrl, date])
  @@index([shop, property, date])
}


model EditorialReview {
  id            String   @id @default(cuid())
  shop          String
  draftId       String
  decision      String
  contentDigest String   @default("")
  reviewMinutes Int?
  feedback      String   @default("")
  reviewedAt    DateTime @default(now())
  @@unique([shop, draftId])
  @@index([shop, reviewedAt])
}


/** Merchant-owned, persistent specialist slots and required skeptics. */
model SwarmAgent {
  id        String   @id @default(cuid())
  shop      String
  role      String
  kind      String
  label     String
  specialty String @default("")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop, role, kind, status])
  @@index([shop, status])
}

/** A bounded research case, never an authorization to mutate the merchant store. */
model SwarmCase {
  id            String   @id @default(cuid())
  shop          String
  role          String
  title         String
  hypothesis    String
  metric        String
  rejectionRule String
  participantsJson String @default("[]")
  reviewRound  Int @default(0)
  status        String   @default("queued")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([shop, status, createdAt])
  @@index([shop, role, createdAt])
}

/** Append-only inter-agent envelopes; sender identity checked server-side. */
model SwarmMessage {
  id           String   @id @default(cuid())
  shop         String
  caseId       String
  senderId     String
  recipientId  String?
  kind         String
  body         String
  evidenceJson String   @default("[]")
  falsifier    String?
  verdict      String?
  reviewRound Int @default(0)
  createdAt    DateTime @default(now())
  @@index([shop, caseId, createdAt])
  @@index([shop, senderId])
}


/** A single bounded attempt per case. No automatic replay after a network call. */
model SwarmExecution {
  id            String   @id @default(cuid())
  shop          String
  caseId        String   @unique
  status        String   @default("reserved")
  provider      String
  model         String
  plan          String
  usageMonth    String
  maxCalls      Int
  callsStarted  Int      @default(0)
  callsFinished Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  leaseToken    String?
  leaseExpiresAt DateTime?
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([shop, status, createdAt])
}

/** Charge exactly once at attempt claim. Unknown HTTP delivery remains charged. */
model SwarmInvocation {
  id          String   @id @default(cuid())
  shop        String
  executionId String
  ordinal     Int
  agentId     String
  phase       String
  status      String   @default("attempted")
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  outputHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([executionId, ordinal])
  @@index([shop, status, createdAt])
}

/** Bounded monthly reservations; all values are model-request units, not dollars. */
model SwarmUsageMonth {
  shop       String
  month      String
  reserved   Int      @default(0)
  consumed   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@id([shop, month])
  @@index([shop, month])
}


/** n8n worker-reported OpenAI token usage, NOT an independently verified invoice. */
model BlogGenerationUsage {
  id             String   @id @default(cuid())
  shop           String
  jobId          String
  stage          String
  provider       String   @default("openai-chat-completions")
  model          String
  inputTokens    Int
  outputTokens   Int
  responseIdHash String?
  reportedAt     DateTime @default(now())
  @@unique([shop, jobId, stage])
  @@index([shop, reportedAt])
}

/** Owner-configured prospective exposure limit; NOT Shopify subscription billing. */
model BlogBudgetPolicy {
  shop                String   @id
  enabled             Boolean  @default(false)
  monthlyCapCents     Int
  perJobReserveCents  Int
  updatedAt           DateTime @updatedAt
}

/** Claimed upper-bound allowances, not invoice-backed actual spend. */
model BlogBudgetMonth {
  shop              String
  month             String
  committedCents    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@id([shop, month])
}

/** Immutable claim tied to one original generation job. */
model BlogBudgetClaim {
  jobId             String   @id
  shop              String
  month             String
  reservedCents     Int
  createdAt         DateTime @default(now())
  @@index([shop, month])
}
